{
  "mode": "collect",
  "version": 1,
  "title": "Full diamond equipment - armor and tools",
  "description": "Collect additional materials and craft one new diamond helmet, chestplate, leggings, boots, pickaxe, axe, shovel, sword and hoe. Requires 35 additional diamonds plus sticks. Existing items do not skip steps in collect mode. Prepare food, stone tools, a furnace and iron equipment first. Keep survival assistance enabled; the task stops if an action cannot progress.",
  "steps": [
    {
      "label": "Hunt and cook 16 additional food portions",
      "action": "food",
      "item": "minecraft:bread",
      "count": 16,
      "role": "food"
    },
    {
      "label": "Collect wood for tables, sticks and cooking fuel",
      "action": "mine",
      "item": "minecraft:oak_log",
      "count": 12,
      "role": "logs"
    },
    {
      "label": "Prepare a wooden pickaxe if needed and collect cobblestone",
      "action": "mine",
      "item": "minecraft:cobblestone",
      "count": 32
    },
    {
      "label": "Craft 1 additional stone pickaxe",
      "action": "craft",
      "item": "minecraft:stone_pickaxe",
      "count": 1,
      "role": "pickaxe"
    },
    {
      "label": "Craft 1 additional stone sword",
      "action": "craft",
      "item": "minecraft:stone_sword",
      "count": 1,
      "role": "sword"
    },
    {
      "label": "Craft 1 additional furnace",
      "action": "craft",
      "item": "minecraft:furnace",
      "count": 1
    },
    {
      "label": "Collect coal for iron smelting and torches",
      "action": "mine",
      "item": "minecraft:coal",
      "count": 12
    },
    {
      "label": "Collect raw iron as needed and smelt 30 additional iron ingots",
      "action": "smelt",
      "item": "minecraft:iron_ingot",
      "count": 30,
      "input": "minecraft:raw_iron"
    },
    {
      "label": "Craft 1 additional iron pickaxe",
      "action": "craft",
      "item": "minecraft:iron_pickaxe",
      "count": 1,
      "role": "pickaxe"
    },
    {
      "label": "Craft 1 additional iron sword",
      "action": "craft",
      "item": "minecraft:iron_sword",
      "count": 1,
      "role": "sword"
    },
    {
      "label": "Craft 1 additional shield",
      "action": "craft",
      "item": "minecraft:shield",
      "count": 1
    },
    {
      "label": "Craft 1 additional iron chestplate",
      "action": "craft",
      "item": "minecraft:iron_chestplate",
      "count": 1
    },
    {
      "label": "Craft 1 additional iron helmet",
      "action": "craft",
      "item": "minecraft:iron_helmet",
      "count": 1
    },
    {
      "label": "Craft 1 additional iron leggings",
      "action": "craft",
      "item": "minecraft:iron_leggings",
      "count": 1
    },
    {
      "label": "Craft 1 additional iron boots",
      "action": "craft",
      "item": "minecraft:iron_boots",
      "count": 1
    },
    {
      "label": "Craft 32 additional torch",
      "action": "craft",
      "item": "minecraft:torch",
      "count": 32
    },
    {
      "label": "Hunt and cook 16 additional food portions",
      "action": "food",
      "item": "minecraft:bread",
      "count": 16,
      "role": "food"
    },
    {
      "label": "Collect 8 additional diamonds for the next armor piece",
      "action": "mine",
      "item": "minecraft:diamond",
      "count": 8
    },
    {
      "label": "Craft 1 additional diamond chestplate",
      "action": "craft",
      "item": "minecraft:diamond_chestplate",
      "count": 1
    },
    {
      "label": "Collect 5 additional diamonds for the next armor piece",
      "action": "mine",
      "item": "minecraft:diamond",
      "count": 5
    },
    {
      "label": "Craft 1 additional diamond helmet",
      "action": "craft",
      "item": "minecraft:diamond_helmet",
      "count": 1
    },
    {
      "label": "Collect 7 additional diamonds for the next armor piece",
      "action": "mine",
      "item": "minecraft:diamond",
      "count": 7
    },
    {
      "label": "Craft 1 additional diamond leggings",
      "action": "craft",
      "item": "minecraft:diamond_leggings",
      "count": 1
    },
    {
      "label": "Collect 4 additional diamonds for the next armor piece",
      "action": "mine",
      "item": "minecraft:diamond",
      "count": 4
    },
    {
      "label": "Craft 1 additional diamond boots",
      "action": "craft",
      "item": "minecraft:diamond_boots",
      "count": 1
    },
    {
      "action": "mine",
      "count": 3,
      "item": "minecraft:diamond",
      "label": "Collect 3 additional diamonds for the pickaxe"
    },
    {
      "action": "craft",
      "count": 1,
      "item": "minecraft:diamond_pickaxe",
      "label": "Craft one additional diamond pickaxe"
    },
    {
      "action": "mine",
      "count": 3,
      "item": "minecraft:diamond",
      "label": "Collect 3 additional diamonds for the axe"
    },
    {
      "action": "craft",
      "count": 1,
      "item": "minecraft:diamond_axe",
      "label": "Craft one additional diamond axe"
    },
    {
      "action": "mine",
      "count": 1,
      "item": "minecraft:diamond",
      "label": "Collect 1 additional diamonds for the shovel"
    },
    {
      "action": "craft",
      "count": 1,
      "item": "minecraft:diamond_shovel",
      "label": "Craft one additional diamond shovel"
    },
    {
      "action": "mine",
      "count": 2,
      "item": "minecraft:diamond",
      "label": "Collect 2 additional diamonds for the sword"
    },
    {
      "action": "craft",
      "count": 1,
      "item": "minecraft:diamond_sword",
      "label": "Craft one additional diamond sword"
    },
    {
      "action": "mine",
      "count": 2,
      "item": "minecraft:diamond",
      "label": "Collect 2 additional diamonds for the hoe"
    },
    {
      "action": "craft",
      "count": 1,
      "item": "minecraft:diamond_hoe",
      "label": "Craft one additional diamond hoe"
    }
  ],
