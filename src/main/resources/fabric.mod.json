{
  "schemaVersion": 1,
  "id": "minecraft-ai-bot",
  "version": "${version}",
  "name": "TaskFlow Bot",
  "description": "A Minecraft client automation mod for ordered task chains, with a visual local web editor, Baritone navigation, crafting, smelting, chest transfers and server menu actions. AI and nearby survival assistance are optional.",
  "authors": [
    "rimurutempest2k3-ctrl"
  ],
  "contact": {
    "issues": "https://github.com/rimurutempest2k3-ctrl/Minecraft-AI-Bot/issues",
    "sources": "https://github.com/rimurutempest2k3-ctrl/Minecraft-AI-Bot"
  },
  "license": "MIT",
  "icon": "assets/minecraft-ai-bot/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "minecraftaibot.MinecraftAIBot"
    ],
    "client": [
      "minecraftaibot.client.MinecraftAIBotClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "baritone": "1.17.0"
  }
}
